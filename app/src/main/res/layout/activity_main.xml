<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_nj"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".MainActivity">

    <LinearLayout
        android:id="@+id/ll_main_nj"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <EditText
            android:id="@+id/et_nom_nj"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nom" />

        <EditText
            android:id="@+id/et_birth_nj"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Année de naissance"
            android:inputType="number" />

        <EditText
            android:id="@+id/et_dest_nj"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Année de destination"
            android:inputType="number" />

        <RadioGroup
            android:id="@+id/rg_motif_nj"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <RadioButton
                android:id="@+id/rb_tourisme_nj"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tourisme" />

            <RadioButton
                android:id="@+id/rb_modification_nj"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Modification du passé" />

            <RadioButton
                android:id="@+id/rb_fuite_nj"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fuite" />
        </RadioGroup>

        <Button
            android:id="@+id/btn_inspecter_nj"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Inspecter le profil" />

    </LinearLayout>
</ScrollView>
